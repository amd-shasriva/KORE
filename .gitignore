# secrets
.env.local
.env
*.key

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# large / generated artifacts (kept out of git; regenerable)
# ignore all run output subdirs (checkpoints/adapters/models) but keep the
# small replay_*.jsonl verification caches at runs/ top level.
runs/*/
runs_smoke/
*.log
# torch.compile / inductor on-disk cache (machine-local, huge, regenerable)
.inductor_cache/

# vendored external repos (large; cloned separately as embedded checkouts)
/repos/
# rocprofv3 profiler dumps (machine-local, regenerable)
.rocprofv3/

# breadth datagen output (large, regenerable; preserved on disk + /shareddata)
data/b05factory/
data/b05factory_synced/

# Replay-cache lock files are transient per-process artifacts, never content.
runs/*.lock
runs/**/*.lock

# Evaluation artifacts are EVIDENCE, not output, and must survive the weights
# they describe. `runs/*/` above exists to keep 221GB checkpoints out of git; it
# was also swallowing ~2MB of JSON/JSONL/markdown that is the only surviving
# record of two checkpoints now deleted -- every generation, per-task measure,
# LM score and paired report behind docs/EVAL_RESULTS.md. Re-included
# explicitly, with a belt-and-braces block on anything weight-shaped in case a
# future harness writes a model into its own output directory.
!runs/eval_ab_*/
!runs/e2e_gate/
runs/**/*.safetensors
runs/**/*.bin
runs/**/*.pt
runs/**/*.pth
runs/**/*.pkl

# Pipeline provenance: which stage ran, as which job, and what it decided.
!runs/pipeline_state.json
!runs/pipeline_driver.log

# Scheduler probes from diagnosing the JobHoldMaxRequeue behaviour. Throwaway.
runs/bisect-*.out
runs/kprobe*-*.out
runs/min-*.out
runs/gpu-smoke-*.out

# Datagen intermediates. These are inputs to the v4 mixture, not the mixture
# itself: the trainable artifact is data/release/sft/multicap_v4.* which is
# tracked in 95MB parts and rebuilt by reassemble.sh. replay_v4.jsonl is 455MB
# on its own, past GitHub's 100MB per-file ceiling, and every one of these is
# reproducible from the scripts in scripts/ -- so tracking them would cost a
# gigabyte and buy nothing.
data/b501remain/
data/b501supp/
data/b501wave3/
data/replay_v4.jsonl
data/task_pool/

# v5 build intermediates and the uncompressed mixture. The mixture IS committed,
# but as gzip parts under data/release/sft/ like every other released corpus --
# 1.8GB of raw JSONL would bloat a repository whose .git is already 1.3GB, and
# data/release/reassemble.sh reconstructs this file byte-identically.
data/v5_sft.jsonl
# The held-out eval half, ignored for the same reason and released the same way
# (data/release/sft/v5_eval.jsonl.gz). Listing it is also protective: it was left
# untracked-but-not-ignored, and repo automation on the cluster runs `git stash -u`
# to preserve a dirty tree, which REMOVES untracked files -- it deleted this file
# once. Ignored files survive that; untracked ones do not.
data/v5_eval.jsonl
data/v5_replay.jsonl
data/v5_translate_*.jsonl
data/v5_flydsl_lang.jsonl
data/v5_modality.jsonl
data/v5_dpo_chosen.jsonl
data/v5_replay_extra.jsonl
data/v5_sft.receipt.json
data/_contaminated_quarantine/
runs/v5_build/
