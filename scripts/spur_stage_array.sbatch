#!/bin/bash
# One full-node SPUR array element for a FRONTIER STAGE (reverify | evolve).
# Task lists are generated by spur_partition.py --mode <stage> (shard_NNN.txt).
# Every array element owns disjoint task IDs; both stages are resumable + write
# atomically, so requeue / burst preemption is always safe.
#SBATCH --job-name=kore-frontier
#SBATCH --account=amd-general
#SBATCH --partition=amd-spur
#SBATCH --qos=amd-general-qos
#SBATCH --nodes=1
#SBATCH --gres=gpu:mi355x:8
#SBATCH --cpus-per-task=128
#SBATCH --time=08:00:00
#SBATCH --requeue
#SBATCH --exclusive
#SBATCH --open-mode=append
#SBATCH --output=/home/shasriva/Kore-RL/KORE/runs/spur-%j.out
#SBATCH --error=/home/shasriva/Kore-RL/KORE/runs/spur-%j.err

set -euo pipefail

REPO="${KORE_REPO:-/home/shasriva/Kore-RL/KORE}"
PY="${KORE_PY:-/home/shasriva/kore-venv/bin/python}"
STAGE="${1:?arg1 must be the stage: reverify|evolve}"
SHARD_DIR="${2:?arg2 must be the absolute shard directory}"
DATA_ROOT="${3:-$REPO/data/b05factory}"
TARGET="${4:-3}"
ARRAY_ID="${SLURM_ARRAY_TASK_ID:?must be submitted as a Slurm array}"

case "$STAGE" in
    reverify|evolve) ;;
    *) echo "unknown stage: $STAGE (want reverify|evolve)" >&2; exit 2 ;;
esac

cd "$REPO"
for cmd in scontrol setsid; do
    command -v "$cmd" >/dev/null || { echo "missing required command: $cmd" >&2; exit 2; }
done

printf -v IDX "%03d" "$ARRAY_ID"
SHARD_FILE="$SHARD_DIR/shard_${IDX}.txt"
[[ -f "$SHARD_FILE" ]] || { echo "missing task list: $SHARD_FILE" >&2; exit 2; }
TASKS="$(cat "$SHARD_FILE" 2>/dev/null || true)"

mkdir -p runs
source /home/shasriva/kore-venv/bin/activate
set -a
source "$REPO/.env.local"
set +a

# Read tuning knobs AFTER .env.local so it can override them. reverify is
# compile/CPU-bound with bursty GPU use (measured: 32 workers => ~14% of 236 cores,
# 6/8 GPUs idle), and nodes have ~2.7TB RAM, so oversubscribe hard: ~80 workers/node
# (10/GPU) puts roughly one worker per task and keeps all 8 GPUs fed.
WORKERS_PER_GPU="${KORE_STAGE_WORKERS_PER_GPU:-10}"
GENS="${KORE_EVOLVE_GENERATIONS:-8}"

# Manifest preflight: the committed source deployed here must match the manifest.
"$PY" - "$SHARD_DIR/manifest.json" "$REPO" "$DATA_ROOT" "$TARGET" "$ARRAY_ID" <<'PY'
import json
from pathlib import Path
import subprocess
import sys

manifest_path, repo, data_root, target, array_id = sys.argv[1:]
manifest = json.loads(Path(manifest_path).read_text())
head = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=repo, text=True).strip()
errors = []
if manifest.get("repo_commit") != head:
    errors.append(f"manifest commit {manifest.get('repo_commit')} != checkout {head}")
if Path(manifest.get("data_root", "")).resolve() != Path(data_root).resolve():
    errors.append("manifest data_root does not match job argument")
if not 0 <= int(array_id) < int(manifest.get("n_shards", 0)):
    errors.append("array index is outside manifest shard range")
if errors:
    raise SystemExit("FATAL manifest preflight: " + "; ".join(errors))
PY

# Fail closed: every production child must see all eight MI355X devices.
VISIBLE_GPUS="$("$PY" -c 'import torch; print(torch.cuda.device_count())')"
if [[ "$VISIBLE_GPUS" != "8" ]]; then
    echo "[frontier-worker] FATAL expected 8 GPUs, found $VISIBLE_GPUS" >&2
    exit 2
fi

# SPUR bind-mounts all eight render devices; drop its physical list before KORE's
# workers apply one logical HIP mask each.
unset ROCR_VISIBLE_DEVICES HIP_VISIBLE_DEVICES CUDA_VISIBLE_DEVICES GPU_DEVICE_ORDINAL

# aiter (production vendor baselines) is a source checkout at repos/aiter.
export PYTHONPATH=.:/home/shasriva/Kore-RL/KORE/repos/aiter
export AITER_USE_SYSTEM_TRITON=1
export KORE_VERIFIED_CORRECTNESS=1
export KORE_COMPILE_BASELINE=1
export KORE_BENCH_COLD=1
export KORE_SHAPE_AUGMENT=1
export KORE_USE_VENDOR_BASELINE="${KORE_USE_VENDOR_BASELINE:-1}"
export GPU_TARGET=gfx950
export PYTHONUNBUFFERED=1
export PYTORCH_HIP_ALLOC_CONF="${PYTORCH_HIP_ALLOC_CONF:-expandable_segments:True}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export OPENBLAS_NUM_THREADS=2
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export NUMEXPR_NUM_THREADS=2
export TORCHINDUCTOR_COMPILE_THREADS=2
export MAX_JOBS=2

# Node-local compile/temp state prevents NFS cache contention; only atomic dataset
# shards + logs go to shared /home, so preemption never loses completed tasks.
LOCAL_ROOT="/mnt/m2m_nobackup/${USER}/kore/${SLURM_JOB_ID}"
export TMPDIR="$LOCAL_ROOT/tmp"
export KORE_COMPILE_CACHE_DIR="$LOCAL_ROOT/compile-cache"
mkdir -p "$TMPDIR" "$KORE_COMPILE_CACHE_DIR"

LOG="runs/spur-${SLURM_JOB_ID}_${ARRAY_ID}-${STAGE}.log"
CHILD_PID=""
REQUEUE_TIMER_PID=""

terminate_child() {
    if [[ -n "$CHILD_PID" ]]; then
        kill -TERM -- "-$CHILD_PID" 2>/dev/null || true
        wait "$CHILD_PID" 2>/dev/null || true
    fi
}
handle_termination() {
    trap - USR1 TERM INT
    terminate_child
    echo "[frontier-worker] signal received; completed shards are safe; exiting for requeue"
    exit 143
}
handle_requeue_warning() {
    trap - USR1 TERM INT
    echo "[frontier-worker] USR1 time-limit warning; draining and requesting requeue"
    terminate_child
    if scontrol requeue "$SLURM_JOB_ID"; then exit 0; fi
    echo "[frontier-worker] FATAL explicit requeue failed" >&2
    exit 143
}
cleanup_local() {
    if [[ -n "$REQUEUE_TIMER_PID" ]]; then kill "$REQUEUE_TIMER_PID" 2>/dev/null || true; fi
    rm -rf -- "$LOCAL_ROOT"
}
trap cleanup_local EXIT
trap handle_termination TERM INT
trap handle_requeue_warning USR1

(
    sleep "${KORE_REQUEUE_AFTER_SECONDS:-28500}"
    kill -USR1 "$$"
) &
REQUEUE_TIMER_PID="$!"

TASK_COUNT="$([ -n "$TASKS" ] && awk -F, '{print NF}' <<<"$TASKS" || echo 0)"
echo "[frontier-worker] START job=$SLURM_JOB_ID array=$ARRAY_ID host=$(hostname) stage=$STAGE shard=$IDX tasks=$TASK_COUNT"

if [[ "$TASK_COUNT" == 0 ]]; then
    echo "[frontier-worker] empty shard; nothing to run"
    exit 0
fi

STATUS=0
if [[ "$STAGE" == "reverify" ]]; then
    # Oversubscribe: reverify is compile/CPU-bound with ~idle GPUs, so run K workers
    # per physical GPU (one --gpus entry per worker).
    GPU_LIST="$("$PY" - "$WORKERS_PER_GPU" <<'PY'
import sys
k = max(1, int(sys.argv[1]))
print(",".join(str(g) for _ in range(k) for g in range(8)))
PY
)"
    KORE_RUNS_DIR="$LOCAL_ROOT/replay/reverify" setsid "$PY" -m kore.data.reverify \
        "$DATA_ROOT" --tasks "$TASKS" --gpus "$GPU_LIST" \
        >"$LOG" 2>&1 &
    CHILD_PID="$!"
else
    N_WORKERS=$(( 8 * WORKERS_PER_GPU ))
    KORE_RUNS_DIR="$LOCAL_ROOT/replay/evolve" setsid "$PY" scripts/evolve_wins.py \
        --data-root "$DATA_ROOT" --tasks "$TASKS" \
        --gpu-ids 0,1,2,3,4,5,6,7 --workers "$N_WORKERS" \
        --target "$TARGET" --generations "$GENS" \
        >"$LOG" 2>&1 &
    CHILD_PID="$!"
fi

if wait "$CHILD_PID"; then
    echo "[frontier-worker] $STAGE completed"
else
    STATUS=$?
    echo "[frontier-worker] $STAGE failed rc=$STATUS"
fi

echo "[frontier-worker] END job=$SLURM_JOB_ID array=$ARRAY_ID stage=$STAGE status=$STATUS"
exit "$STATUS"
